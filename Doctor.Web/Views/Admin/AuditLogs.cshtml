@model List<Doctor.Web.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "سجل العمليات والتدقيق (Audit Logs)";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary ms-2"></i>سجل العمليات والتدقيق الأمني</h3>
        <p class="text-muted small mb-0">توثيق وتسجيل كافة الإجراءات الحساسة والتغييرات التي تمت بالنظام</p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="بحث بالإجراء أو الكيان أو التفاصيل..." value="@Context.Request.Query["search"]" />
            </div>
            <div class="col-md-3">
                <input type="date" name="from" class="form-control form-control-sm" value="@Context.Request.Query["from"]" />
            </div>
            <div class="col-md-3">
                <input type="date" name="to" class="form-control form-control-sm" value="@Context.Request.Query["to"]" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter ms-1"></i> تصفية
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>الوقت والتاريخ</th>
                    <th>المستخدم</th>
                    <th>الإجراء (Action)</th>
                    <th>الكيان (Entity)</th>
                    <th>التفاصيل والملاحظات</th>
                    <th>عنوان IP</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-nowrap small text-muted">@log.Timestamp.ToString("yyyy/MM/dd HH:mm:ss")</td>
                            <td>
                                <span class="fw-bold text-dark">@(log.User?.FullName ?? log.UsernameSnapshot)</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@log.Action</span>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary">@log.Entity</span>
                                @if (!string.IsNullOrEmpty(log.EntityId))
                                {
                                    <span class="text-muted small">#@log.EntityId</span>
                                }
                            </td>
                            <td class="small">@log.Details</td>
                            <td class="small text-muted font-monospace">@(log.IpAddress ?? "-")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted small">لا توجد سجلات تطابق معايير البحث</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
