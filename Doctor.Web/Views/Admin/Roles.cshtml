@model List<Doctor.Web.Models.Entities.UserRole>
@{
    ViewData["Title"] = "الأدوار والصلاحيات";
    var allPermissions = ViewBag.AllPermissions as List<Doctor.Web.Models.Entities.Permission> ?? new();
    var categories = allPermissions.GroupBy(p => p.Category).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-primary ms-2"></i>نظام الأدوار والصلاحيات (RBAC)</h3>
        <p class="text-muted small mb-0">تحديد صلاحيات دقيقة لكل دور لمنع الوصول غير المصرح به لأي صفحة أو عملية</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white p-3">
        <ul class="nav nav-pills" id="roleTabs" role="tablist">
            @for (int i = 0; i < Model.Count; i++)
            {
                var role = Model[i];
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(i == 0 ? "active" : "") fw-bold" id="tab-@role.Id" data-bs-toggle="pill" data-bs-target="#content-@role.Id" type="button" role="tab">
                        <i class="bi bi-shield-check ms-1"></i> @role.NameAr (@role.Name)
                    </button>
                </li>
            }
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content" id="roleTabsContent">
            @for (int i = 0; i < Model.Count; i++)
            {
                var role = Model[i];
                var assignedIds = role.RolePermissions.Select(rp => rp.PermissionId).ToHashSet();

                <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="content-@role.Id" role="tabpanel">
                    <div class="alert alert-light border mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="fw-bold mb-1">وصف الدور: @role.NameAr</h6>
                            <p class="text-muted small mb-0">@(role.Description ?? "صلاحيات مخصصة داخل النظام")</p>
                        </div>
                        @if (role.Name == "Admin")
                        {
                            <span class="badge bg-danger fs-6 py-2 px-3">المدير يملك كافة الصلاحيات تلقائياً</span>
                        }
                    </div>

                    <form asp-action="UpdateRolePermissions" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="roleId" value="@role.Id" />

                        <div class="row g-4">
                            @foreach (var cat in categories)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 border shadow-none bg-light bg-opacity-50">
                                        <div class="card-header bg-white fw-bold py-2 border-bottom">
                                            <i class="bi bi-folder-check text-primary ms-1"></i> @cat.Key
                                        </div>
                                        <div class="card-body p-3">
                                            @foreach (var perm in cat)
                                            {
                                                bool isChecked = assignedIds.Contains(perm.Id) || role.Name == "Admin";
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="checkbox" name="permissionIds" value="@perm.Id" id="perm_@(role.Id)_@(perm.Id)" @(isChecked ? "checked" : "") @(role.Name == "Admin" ? "disabled" : "") />
                                                    <label class="form-check-label small" for="perm_@(role.Id)_@(perm.Id)">
                                                        <span class="fw-semibold">@perm.NameAr</span>
                                                        <br />
                                                        <span class="text-muted" style="font-size: 0.72rem;">@perm.Code</span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (role.Name != "Admin")
                        {
                            <div class="mt-4 pt-3 border-top text-end">
                                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                    <i class="bi bi-save ms-1"></i> حفظ صلاحيات (@role.NameAr)
                                </button>
                            </div>
                        }
                    </form>
                </div>
            }
        </div>
    </div>
</div>
