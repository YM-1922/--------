@model Doctor.Web.Services.InventoryReportViewModel
@{
    ViewData["Title"] = "تقرير تقييم مخزون الأجهزة";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-boxes text-primary ms-2"></i>تقرير تقييم مخزون الأجهزة</h3>
        <p class="text-muted small mb-0">تقييم شامل لكميات وقيمة أجهزة الموبايل والهواتف الذكية والأرباح المتوقعة</p>
    </div>
    <div class="btn-group">
        <a href="@Url.Action("Reports", "Admin", new { type = "sales" })" class="btn btn-outline-secondary btn-sm">تقرير المبيعات</a>
        <a href="@Url.Action("Reports", "Admin", new { type = "inventory" })" class="btn btn-primary btn-sm active">تقييم المخزون</a>
    </div>
</div>

<!-- Valuation KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card stat-indigo">
            <div class="stat-title">قيمة المخزون بسعر الشراء (التكلفة)</div>
            <div class="stat-value">@Model.TotalInventoryCostValue.ToString("N0") <span class="fs-6 text-muted">ج.م</span></div>
            <div class="small text-muted mt-2">رأس المال المستثمر حالياً في أجهزة الموبايل</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card stat-primary">
            <div class="stat-title">قيمة المخزون بسعر البيع المتوقع</div>
            <div class="stat-value">@Model.TotalInventorySellingValue.ToString("N0") <span class="fs-6 text-muted">ج.م</span></div>
            <div class="small text-muted mt-2">القيمة السوقية لكافة الأجهزة بالسنتر</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card stat-success">
            <div class="stat-title">الأرباح المتوقعة عند بيع المخزون</div>
            <div class="stat-value">@Model.PotentialProfit.ToString("N0") <span class="fs-6 text-muted">ج.م</span></div>
            <div class="small text-success mt-2 fw-bold">إجمالي هامش الربح المتاح بالمخزن</div>
        </div>
    </div>
</div>

<!-- Stock Quantities Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3 shadow-sm border-start border-primary border-4 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold">إجمالي أجهزة الموبايل المتوفرة</div>
                    <h4 class="fw-bold mb-0 mt-1 text-primary">@Model.TotalDevicesCount <small class="fs-6 text-muted">جهاز جاهز للبيع</small></h4>
                </div>
                <i class="bi bi-phone-fill fs-2 text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 shadow-sm border-start border-warning border-4 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold">الأجهزة التي اقتربت من النفاد</div>
                    <h4 class="fw-bold mb-0 mt-1 text-warning">@Model.LowStockProducts.Count <small class="fs-6 text-muted">موديل تحت الحد الأدنى</small></h4>
                </div>
                <i class="bi bi-exclamation-triangle-fill fs-2 text-warning"></i>
            </div>
        </div>
    </div>
</div>

<!-- Low Stock Details Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-danger"><i class="bi bi-exclamation-triangle ms-2"></i>الأجهزة التي وصلت للحد الأدنى (نواقص المخزن)</h6>
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer ms-1"></i> طباعة تقرير النواقص
        </button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>اسم الجهاز</th>
                    <th>الشركة والموديل</th>
                    <th>المواصفات (رام ومساحة)</th>
                    <th>الباركود</th>
                    <th>الكمية المتاحة</th>
                    <th>الحد الأدنى</th>
                    <th>سعر الشراء</th>
                    <th>سعر البيع</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LowStockProducts.Any())
                {
                    foreach (var p in Model.LowStockProducts)
                    {
                        <tr>
                            <td><strong>@p.Name</strong></td>
                            <td>@(p.Brand?.Name ?? "-")</td>
                            <td>@(p.Storage ?? "-") / @(p.Ram ?? "-")</td>
                            <td class="font-monospace">@p.Barcode</td>
                            <td><span class="badge bg-danger">@p.StockQuantity قطعة</span></td>
                            <td>@p.MinStockLevel</td>
                            <td class="text-muted">@p.PurchasePrice.ToString("N0") ج.م</td>
                            <td class="fw-bold text-success">@p.SellingPrice.ToString("N0") ج.م</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">لا توجد أجهزة منخفضة المخزون حالياً، مستويات المخزون ممتازة.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
