@model Doctor.Web.Services.SalesReportViewModel
@{
    ViewData["Title"] = "تقرير المبيعات الشامل والأجهزة";
    string todayStr = DateTime.UtcNow.ToString("yyyy-MM-dd");
    string yesterdayStr = DateTime.UtcNow.AddDays(-1).ToString("yyyy-MM-dd");
    string weekStartStr = DateTime.UtcNow.AddDays(-6).ToString("yyyy-MM-dd");
    string monthStartStr = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1).ToString("yyyy-MM-dd");
    bool isToday = (ViewBag.FromDate == todayStr && ViewBag.ToDate == todayStr);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-primary ms-2"></i>تقرير المبيعات وتحليل الأجهزة</h3>
        <p class="text-muted small mb-0">تحليل نهاية اليوم، مبيعات الماركات، أكثر الأجهزة طلباً، وتنبيهات المخزون والركود</p>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group">
            <a href="@Url.Action("Reports", "Admin", new { type = "sales", from = todayStr, to = todayStr })" class="btn btn-sm @(isToday ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-calendar-check ms-1"></i> تقرير اليوم (إغلاق اليوم)
            </a>
            <a href="@Url.Action("Reports", "Admin", new { type = "inventory" })" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-boxes ms-1"></i> تقييم المخزون
            </a>
        </div>
        <button onclick="window.print()" class="btn btn-sm btn-dark d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-printer"></i> طباعة التقرير
        </button>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body p-3 bg-light rounded-3">
        <form method="get" class="row g-2 align-items-center">
            <input type="hidden" name="type" value="sales" />
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">من تاريخ</label>
                <input type="date" name="from" id="fromDateInput" class="form-control form-control-sm bg-white" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                <input type="date" name="to" id="toDateInput" class="form-control form-control-sm bg-white" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                    <i class="bi bi-filter ms-1"></i> تطبيق التصفية
                </button>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-1 flex-wrap">
                <a href="@Url.Action("Reports", "Admin", new { type = "sales", from = todayStr, to = todayStr })" class="btn btn-outline-secondary btn-sm py-1 px-2">اليوم</a>
                <a href="@Url.Action("Reports", "Admin", new { type = "sales", from = yesterdayStr, to = yesterdayStr })" class="btn btn-outline-secondary btn-sm py-1 px-2">أمس</a>
                <a href="@Url.Action("Reports", "Admin", new { type = "sales", from = weekStartStr, to = todayStr })" class="btn btn-outline-secondary btn-sm py-1 px-2">آخر 7 أيام</a>
                <a href="@Url.Action("Reports", "Admin", new { type = "sales", from = monthStartStr, to = todayStr })" class="btn btn-outline-secondary btn-sm py-1 px-2">هذا الشهر</a>
            </div>
        </form>
    </div>
</div>

<!-- Top Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold mb-1"><i class="bi bi-phone text-primary ms-1"></i> الأجهزة المباعة</div>
                <div class="fs-3 fw-bold text-dark">@Model.TotalDevicesSoldCount <span class="fs-6 text-muted fw-normal">جهاز</span></div>
                <div class="small text-muted mt-1">+ @Model.TotalAccessoriesSoldCount قطعة إكسسوار</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold mb-1"><i class="bi bi-cash-stack text-success ms-1"></i> صافي المبيعات المحققة</div>
                <div class="fs-3 fw-bold text-success">@Model.TotalNetSales.ToString("N0") <span class="fs-6 fw-normal">ج.م</span></div>
                <div class="small text-muted mt-1">من إجمالي @Model.InvoiceCount فاتورة</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold mb-1"><i class="bi bi-graph-up text-info ms-1"></i> صافي الأرباح التقديرية</div>
                <div class="fs-3 fw-bold text-primary">@Model.TotalProfit.ToString("N0") <span class="fs-6 text-muted fw-normal">ج.م</span></div>
                <div class="small text-muted mt-1">بعد خصم تكلفة الشراء</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold mb-1"><i class="bi bi-trophy-fill text-warning ms-1"></i> الجهاز الأكثر مبيعاً</div>
                <div class="fs-5 fw-bold text-truncate" title="@(Model.TopSellingDevice?.ProductName ?? "لا توجد مبيعات أجهزة")">
                    @(Model.TopSellingDevice?.ProductName ?? "لا يوجد")
                </div>
                <div class="small text-muted mt-1">
                    @(Model.TopSellingDevice != null ? $"تم بيع {Model.TopSellingDevice.QuantitySold} جهاز بقيمة {Model.TopSellingDevice.TotalRevenue:N0} ج.م" : "في الفترة المحددة")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Brand Intelligence & Analytics Section -->
<div class="row g-3 mb-4">
    <!-- Brand Breakdown -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart-fill text-primary ms-2"></i> توزيع مبيعات الأجهزة حسب الماركة
                </h6>
                <span class="badge bg-primary-subtle text-primary">إجمالي: @Model.TotalDevicesSoldCount جهاز</span>
            </div>
            <div class="card-body p-3">
                @if (Model.BrandSalesBreakdown.Any())
                {
                    <div class="mb-3">
                        @foreach (var b in Model.BrandSalesBreakdown)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1 small">
                                    <span class="fw-bold fs-6">@b.BrandName</span>
                                    <span>
                                        <strong class="text-primary">@b.DevicesSold جهاز</strong>
                                        <span class="text-muted">(@b.Percentage%)</span>
                                        <span class="text-muted ms-2">| @b.TotalRevenue.ToString("N0") ج.م</span>
                                    </span>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @b.Percentage%;" aria-valuenow="@b.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.BrandSalesBreakdown.FirstOrDefault() != null)
                    {
                        var topBrand = Model.BrandSalesBreakdown.First();
                        <div class="alert alert-info border-info-subtle d-flex align-items-start gap-2 p-2 small mb-0">
                            <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
                            <div>
                                <strong>توجيه ذكي لمبيعاتك:</strong>
                                ماركة <strong>(@topBrand.BrandName)</strong> هي الأكثر طلباً بنسبة (@topBrand.Percentage%) من إجمالي الأجهزة المباعة. احرص على تعزيز مخزونها باستمرار، ووجّه العروض الترويجية لباقي الماركات لتنشيط مبيعاتها.
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                        لم يتم تسجيل مبيعات أجهزة في هذه الفترة
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Stock Alerts & Recommendations -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-exclamation-triangle-fill text-warning ms-2"></i> أجهزة شارف مخزونها على النفاد
                </h6>
                <span class="badge bg-warning-subtle text-warning-emphasis">تحتاج تزويد</span>
            </div>
            <div class="card-body p-0">
                @if (Model.LowStockDevices.Any())
                {
                    <div class="table-responsive" style="max-height: 280px;">
                        <table class="table table-sm table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>الجهاز</th>
                                    <th>الماركة</th>
                                    <th class="text-center">الرصيد المتبقي</th>
                                    <th>سعر البيع</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LowStockDevices)
                                {
                                    <tr>
                                        <td><strong>@item.Name</strong></td>
                                        <td><span class="badge bg-light text-dark border">@item.BrandName</span></td>
                                        <td class="text-center">
                                            <span class="badge bg-danger-subtle text-danger fw-bold fs-6">@item.CurrentStock جهاز</span>
                                        </td>
                                        <td class="text-muted">@item.SellingPrice.ToString("N0") ج.م</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-success small">
                        <i class="bi bi-check-circle fs-2 d-block mb-2"></i>
                        كافة الأجهزة المتوفرة بمخزون كافٍ يتجاوز حد الأمان
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Slow Moving Devices (Zero Sales in Period) -->
@if (Model.SlowMovingDevices.Any())
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold mb-1 text-dark">
                    <i class="bi bi-hourglass-split text-secondary ms-2"></i> أجهزة متوفرة بالمخزن ولم يُبع منها في هذه الفترة
                </h6>
                <p class="text-muted small mb-0">يمكنك عمل عروض أو خصومات على هذه الأجهزة لتسريع حركة رأس المال</p>
            </div>
            <span class="badge bg-light text-dark border">@Model.SlowMovingDevices.Count صنف متوفر</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>اسم الجهاز</th>
                        <th>الماركة</th>
                        <th class="text-center">الكمية المتوفرة بالمخزن</th>
                        <th>سعر البيع الحالي</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.SlowMovingDevices)
                    {
                        <tr>
                            <td><strong>@d.Name</strong></td>
                            <td><span class="badge bg-light text-dark border">@d.BrandName</span></td>
                            <td class="text-center fw-bold">@d.CurrentStock جهاز</td>
                            <td class="text-primary fw-bold">@d.SellingPrice.ToString("N0") ج.م</td>
                            <td><span class="badge bg-secondary-subtle text-secondary">جاهز للبيع / راكد بالفترة</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Sales Invoices Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">سجل فواتير الفترة المحددة (@Model.InvoiceCount فاتورة)</h6>
        <div class="small text-muted">
            إجمالي الخصومات الممنوحة: <strong class="text-danger">@Model.TotalDiscounts.ToString("N0") ج.م</strong>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>رقم الفاتورة</th>
                    <th>التاريخ والوقت</th>
                    <th>العميل</th>
                    <th>البائع</th>
                    <th>طريقة الدفع</th>
                    <th>الأصناف المباعة</th>
                    <th>الإجمالي</th>
                    <th>إجراء</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Sales.Any())
                {
                    foreach (var s in Model.Sales)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@s.InvoiceNumber</strong></td>
                            <td class="small text-muted">@s.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>@(s.Customer?.Name ?? "عميل نقدي")</td>
                            <td>@s.User.FullName</td>
                            <td><span class="badge bg-light text-dark border">@s.PaymentMethod</span></td>
                            <td>
                                <div class="small text-muted">
                                    @foreach (var item in s.Items)
                                    {
                                        <span class="badge bg-light text-dark border me-1">@item.Product.Name (×@item.Quantity)</span>
                                    }
                                </div>
                            </td>
                            <td class="fw-bold text-dark fs-6">@s.TotalAmount.ToString("N2") ج.م</td>
                            <td>
                                <a href="@Url.Action("Invoice", "Sales", new { id = s.InvoiceNumber })" class="btn btn-sm btn-outline-primary py-1 px-2" title="عرض الفاتورة">
                                    <i class="bi bi-printer ms-1"></i> الفاتورة
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted small">لم يتم العثور على أي فواتير في هذه الفترة</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
