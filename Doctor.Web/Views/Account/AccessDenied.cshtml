@{
    ViewData["Title"] = "غير مصرح بالوصول";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3"><i class="bi bi-shield-x"></i></div>
    <h2 class="fw-bold text-dark">عفواً، لا تملك الصلاحية الكافية</h2>
    <p class="text-muted col-md-6 mx-auto">
        ليس لديك الإذن أو الصلاحيات اللازمة للوصول إلى هذه الصفحة أو تنفيذ هذا الإجراء. إذا كنت تعتقد أن هذا خطأ، يرجى مراجعة مدير النظام.
    </p>
    <div class="mt-4">
        <a href="javascript:history.back()" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-right ms-1"></i> العودة للصفحة السابقة
        </a>
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
            <i class="bi bi-house ms-1"></i> الانتقال للرئيسية
        </a>
    </div>
</div>
