@model List<Doctor.Web.Models.Entities.Brand>
@{
    ViewData["Title"] = "إدارة الشركات والماركات";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-apple text-primary ms-2"></i>الشركات والماركات</h3>
        <p class="text-muted small mb-0">إدارة ماركات الهواتف والأجهزة الذكية وقطع الغيار</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#createBrandModal">
        <i class="bi bi-plus-circle"></i> إضافة شركة جديدة
    </button>
</div>

<div class="row g-3">
    @foreach (var brand in Model)
    {
        <div class="col-md-4 col-xl-3">
            <div class="card shadow-sm h-100 p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-light p-2 text-primary ms-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="bi bi-tag-fill fs-5"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-dark">@brand.Name</h5>
                    </div>
                    @if (!brand.Products.Any())
                    {
                        <form asp-action="DeleteBrand" method="post" onsubmit="return confirm('هل أنت متأكد من حذف هذه الشركة؟')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@brand.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1" title="حذف">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top text-muted small">
                    <span>المنتجات المرتبطة:</span>
                    <strong class="text-primary">@brand.Products.Count منتج</strong>
                </div>
            </div>
        </div>
    }
</div>

<!-- Create Brand Modal -->
<div class="modal fade" id="createBrandModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form asp-action="CreateBrand" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light py-2">
                    <h6 class="modal-title fw-bold">إضافة شركة جديدة</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small fw-bold">اسم الشركة / البراند</label>
                    <input type="text" name="name" class="form-control" placeholder="مثال: Google, Huawei, Sony" required />
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary btn-sm">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>
