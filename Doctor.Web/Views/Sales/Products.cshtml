@model List<Doctor.Web.Models.Entities.Product>
@{
    ViewData["Title"] = "إدارة الهواتف والأجهزة";
    var brands = ViewBag.Brands as List<Doctor.Web.Models.Entities.Brand> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-phone text-primary ms-2"></i>إدارة الهواتف والأجهزة</h3>
        <p class="text-muted small mb-0">متابعة مخزون الأجهزة، الماركات، السيريال والـ IMEI، وأسعار الشراء والبيع</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("CreateProduct", "Sales")" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> إضافة جهاز جديد
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="بحث باسم الجهاز، الموديل، الباركود، أو الـ IMEI..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="brandId" class="form-select form-select-sm">
                    <option value="">كافة الشركات والماركات (@brands.Count شركة)</option>
                    @foreach (var b in brands)
                    {
                        <!option value="@b.Id" @(ViewBag.BrandId == b.Id ? "selected" : "")>@b.Name</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter ms-1"></i> بحث وتصفية
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Products Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>الجهاز</th>
                    <th>الشركة</th>
                    <th>المواصفات (الرام والمساحة)</th>
                    <th>السيريال / IMEI</th>
                    <th>الباركود</th>
                    <th>سعر الشراء</th>
                    <th>سعر البيع</th>
                    <th>المخزون الحالي</th>
                    <th class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var p in Model)
                    {
                        var profit = p.SellingPrice - p.PurchasePrice;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-3 bg-primary-subtle d-flex align-items-center justify-content-center ms-2 text-primary flex-shrink-0 overflow-hidden" style="width: 38px; height: 38px; font-size: 1.25rem;">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" style="width: 100%; height: 100%; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-phone"></i>
                                        }
                                    </div>
                                    <div>
                                        <strong class="text-dark">@p.Name</strong>
                                        @if (!string.IsNullOrEmpty(p.Color))
                                        {
                                            <div class="text-muted small"><i class="bi bi-palette ms-1"></i>اللون: @p.Color</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-tag-fill text-primary ms-1"></i>@(p.Brand?.Name ?? "-")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (!string.IsNullOrEmpty(p.Storage))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis">@p.Storage</span>
                                    }
                                    @if (!string.IsNullOrEmpty(p.Ram))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">@p.Ram رام</span>
                                    }
                                    @if (string.IsNullOrEmpty(p.Storage) && string.IsNullOrEmpty(p.Ram))
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </div>
                            </td>
                            <td class="font-monospace small">
                                @if (!string.IsNullOrEmpty(p.SerialNumberOrImei))
                                {
                                    <span class="badge bg-light text-secondary border font-monospace">@p.SerialNumberOrImei</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="font-monospace small">
                                <span class="fw-bold text-dark">@p.Barcode</span>
                            </td>
                            <td class="small text-muted">@p.PurchasePrice.ToString("N0") ج.م</td>
                            <td>
                                <span class="fw-bold text-success">@p.SellingPrice.ToString("N0") ج.م</span>
                                @if (profit > 0)
                                {
                                    <div class="text-muted" style="font-size: 0.75rem;">(ربح: +@profit.ToString("N0"))</div>
                                }
                            </td>
                            <td>
                                @if (p.StockQuantity <= 0)
                                {
                                    <span class="badge bg-danger">نفد المخزون (0)</span>
                                }
                                else if (p.StockQuantity <= p.MinStockLevel)
                                {
                                    <span class="badge bg-warning text-dark">منخفض (@p.StockQuantity)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">@p.StockQuantity جهاز</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("PrintLabels", "Barcode", new { barcode = p.Barcode, name = p.Name, price = p.SellingPrice, model = p.Model })" class="btn btn-outline-secondary" title="طباعة ملصق الباركود">
                                        <i class="bi bi-upc-scan"></i>
                                    </a>
                                    <a href="@Url.Action("EditProduct", "Sales", new { id = p.Id })" class="btn btn-outline-primary" title="تعديل بيانات الجهاز">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="@Url.Action("DeleteProduct", "Sales", new { id = p.Id })" class="btn btn-outline-danger" onclick="return confirm('هل أنت متأكد من رغبتك بحذف جهاز (@p.Name)؟')" title="حذف الجهاز">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-phone display-6 d-block text-secondary mb-2"></i>
                            لم يتم العثور على أي أجهزة مطابقة. يمكنك إضافة جهاز جديد بالنقر على زر إضافة أعلاه.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
