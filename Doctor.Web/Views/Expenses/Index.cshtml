@model List<Doctor.Web.Models.Entities.Expense>
@{
    ViewData["Title"] = "مصروفات المحل والملاحظات";
    decimal periodTotal = ViewBag.PeriodTotal ?? 0m;
    decimal allTimeTotal = ViewBag.AllTimeTotal ?? 0m;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-wallet2 text-primary ms-2"></i>مصروفات المحل والملاحظات</h3>
        <p class="text-muted small mb-0">تسجيل ومتابعة كافة المصروفات اليومية والنثريات وملاحظات المحل بالتاريخ والوقت</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
            <i class="bi bi-plus-circle-fill"></i> تسجيل مصروف / ملاحظة جديدة
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">إجمالي المصروفات (للفترة المحددة)</span>
                        <h4 class="fw-bold mb-0 text-danger">@periodTotal.ToString("N2") <span class="fs-6 fw-normal text-muted">ج.م</span></h4>
                    </div>
                    <div class="rounded-circle bg-danger-subtle text-danger p-3">
                        <i class="bi bi-cash-coin fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">إجمالي المصروفات الكلي</span>
                        <h4 class="fw-bold mb-0 text-dark">@allTimeTotal.ToString("N2") <span class="fs-6 fw-normal text-muted">ج.م</span></h4>
                    </div>
                    <div class="rounded-circle bg-primary-subtle text-primary p-3">
                        <i class="bi bi-wallet-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">عدد السجلات المسجلة</span>
                        <h4 class="fw-bold mb-0 text-info">@totalCount <span class="fs-6 fw-normal text-muted">سجل</span></h4>
                    </div>
                    <div class="rounded-circle bg-info-subtle text-info p-3">
                        <i class="bi bi-journal-text fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="بحث بالبند أو الملاحظات..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" title="من تاريخ" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" title="إلى تاريخ" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                    <i class="bi bi-funnel ms-1"></i> تصفية
                </button>
                <a href="@Url.Action("Index", "Expenses")" class="btn btn-outline-secondary btn-sm" title="إلغاء الفلتر">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Expenses Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>بند المصروف / الملاحظة</th>
                    <th>التفاصيل والملاحظات</th>
                    <th>المبلغ</th>
                    <th>التاريخ والوقت</th>
                    <th>المستخدم</th>
                    <th class="text-center" style="width: 140px;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    int index = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted small">@index</td>
                            <td>
                                <strong class="text-dark">@item.Title</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <span class="text-secondary small">@item.Notes</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-danger fs-6 font-monospace">@item.Amount.ToString("N2")</span> <small class="text-muted">ج.م</small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 small text-muted">
                                    <i class="bi bi-clock-history text-primary"></i>
                                    <span>@item.ExpenseDate.ToString("yyyy/MM/dd hh:mm:ss tt")</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-person ms-1"></i>@(item.User?.FullName ?? "النظام")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary" 
                                            onclick="openEditExpenseModal(@item.Id, '@Html.Raw(Html.Encode(item.Title))', '@Html.Raw(Html.Encode(item.Notes ?? ""))', @item.Amount, '@item.ExpenseDate.ToString("yyyy-MM-ddTHH:mm")')"
                                            title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-controller="Expenses" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('هل أنت متأكد من حذف هذا المصروف / الملاحظة نهائياً؟');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="حذف">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            لم يتم العثور على أي مصروفات أو ملاحظات مسجلة في هذا النطاق.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add Expense -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-controller="Expenses" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fs-6 fw-bold" id="addExpenseModalLabel">
                        <i class="bi bi-plus-circle ms-2"></i>تسجيل مصروف / ملاحظة جديدة للمحل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">بند المصروف / عنوان الملاحظة <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control" placeholder="مثال: فاتورة كهرباء، إيجار، أدوات نظافة، شاي وضيافة..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">قيمة المصروف (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="Amount" class="form-control" placeholder="0.00" value="0.00" required min="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">التاريخ والوقت <span class="text-muted">(تلقائي بالتوقيت الحالي)</span></label>
                        <input type="datetime-local" name="ExpenseDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">تفاصيل وملاحظات إضافية</label>
                        <textarea name="Notes" class="form-control" rows="3" placeholder="أي تفاصيل أو ملاحظات تخص هذا المصروف..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4 justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-check-lg ms-1"></i> حفظ المصروف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Expense -->
<div class="modal fade" id="editExpenseModal" tabindex="-1" aria-labelledby="editExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form id="editExpenseForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fs-6 fw-bold" id="editExpenseModalLabel">
                        <i class="bi bi-pencil-square ms-2"></i>تعديل المصروف / الملاحظة
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="editExpenseId" name="Id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold small">بند المصروف / عنوان الملاحظة <span class="text-danger">*</span></label>
                        <input type="text" id="editExpenseTitle" name="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">قيمة المصروف (ج.م) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" id="editExpenseAmount" name="Amount" class="form-control" required min="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">التاريخ والوقت</label>
                        <input type="datetime-local" id="editExpenseDate" name="ExpenseDate" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">تفاصيل وملاحظات إضافية</label>
                        <textarea id="editExpenseNotes" name="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4 justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-check-lg ms-1"></i> حفظ التعديلات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditExpenseModal(id, title, notes, amount, date) {
        document.getElementById('editExpenseForm').action = '/Expenses/Edit/' + id;
        document.getElementById('editExpenseId').value = id;
        document.getElementById('editExpenseTitle').value = title;
        document.getElementById('editExpenseNotes').value = notes;
        document.getElementById('editExpenseAmount').value = amount;
        document.getElementById('editExpenseDate').value = date;

        var modal = new bootstrap.Modal(document.getElementById('editExpenseModal'));
        modal.show();
    }
</script>
}
