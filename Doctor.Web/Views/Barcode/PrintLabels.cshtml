@{
    Layout = null;
    string barcode = ViewBag.Barcode as string ?? "";
    string name = ViewBag.Name as string ?? "";
    decimal price = ViewBag.Price ?? 0m;
    int count = ViewBag.Count ?? 1;
    string? model = ViewBag.Model as string;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>طباعة ملصقات الباركود - @name</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f1f5f9;
            padding: 1.5rem;
            font-family: 'Cairo', sans-serif;
        }
        .barcode-sheet {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
        }
        .sticker-card {
            width: 50mm;
            height: 30mm;
            background: #fff;
            border: 1px dashed #ccc;
            padding: 2mm 3mm;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-sizing: border-box;
            overflow: hidden;
        }
        .sticker-title {
            font-size: 8pt;
            font-weight: 700;
            line-height: 1.1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .sticker-price {
            font-size: 8pt;
            font-weight: 800;
            color: #000;
        }
        .sticker-center {
            font-size: 6pt;
            color: #666;
        }
        @@media print {
            body {
                background: #fff !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .no-print {
                display: none !important;
            }
            .sticker-card {
                border: none !important;
                page-break-inside: avoid !important;
                float: right;
            }
            .barcode-sheet {
                gap: 2mm !important;
            }
        }
    </style>
</head>
<body>
    <div class="text-center mb-4 no-print">
        <button type="button" class="btn btn-primary px-4 py-2 fw-bold shadow-sm" onclick="window.print()">
            <i class="bi bi-printer-fill ms-1"></i> طباعة الملصقات الآن (@count ملصق)
        </button>
        <button type="button" class="btn btn-outline-secondary ms-2" onclick="window.close()">
            إغلاق النافذة
        </button>
    </div>

    <div class="barcode-sheet">
        @for (int i = 0; i < count; i++)
        {
            <div class="sticker-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="sticker-center">دكتور سنتر</span>
                    <span class="sticker-price">@price.ToString("N0") ج.م</span>
                </div>
                <div class="sticker-title">@name</div>
                <div class="my-auto">
                    <svg class="barcode-svg" data-barcode="@barcode" style="width: 100%; height: 14mm;"></svg>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.barcode-svg').forEach(svg => {
                const code = svg.getAttribute('data-barcode');
                try {
                    JsBarcode(svg, code, {
                        format: "CODE128",
                        width: 1.2,
                        height: 25,
                        displayValue: true,
                        fontSize: 8,
                        margin: 0
                    });
                } catch (e) {
                    console.error('JsBarcode error:', e);
                }
            });
        });
    </script>
</body>
</html>
