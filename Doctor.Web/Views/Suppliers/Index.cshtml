@model List<Doctor.Web.Models.Entities.Supplier>
@{
    ViewData["Title"] = "إدارة الموردين والحسابات";
    decimal totalDebt = ViewBag.TotalDebtToSuppliers ?? 0m;
    int totalSuppliers = ViewBag.TotalSuppliers ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-truck text-primary ms-2"></i>إدارة الموردين وحسابات التوريد</h3>
        <p class="text-muted small mb-0">متابعة حسابات موردي الأجهزة، فواتير التوريد، والمديونيات والمستحقات</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
            <i class="bi bi-person-plus-fill"></i> إضافة مورد جديد
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-white border-start border-primary border-4">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 ms-3">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">إجمالي الموردين</span>
                    <h4 class="fw-bold mb-0">@totalSuppliers <span class="fs-6 fw-normal text-muted">مورد</span></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-white border-start border-danger border-4">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-3 bg-danger-subtle text-danger p-3 ms-3">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">إجمالي المستحقات للموردين (ديون)</span>
                    <h4 class="fw-bold text-danger mb-0">@totalDebt.ToString("N0") <span class="fs-6 fw-normal text-muted">ج.م</span></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-white border-start border-success border-4">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-3 bg-success-subtle text-success p-3 ms-3">
                    <i class="bi bi-phone-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">موردي الأجهزة الفعليين</span>
                    <h4 class="fw-bold text-success mb-0">@Model.Count <span class="fs-6 fw-normal text-muted">مسجل</span></h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="بحث بالاسم، اسم الشركة أو رقم الهاتف..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" name="onlyDebt" value="true" id="onlyDebtCheck" @(ViewBag.OnlyDebt == true ? "checked" : "") onchange="this.form.submit()">
                    <label class="form-check-label small" for="onlyDebtCheck">فقط من لهم مستحقات</label>
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter ms-1"></i> تصفية
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Suppliers Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>المورد / الشركة</th>
                    <th>الهاتف والاتصال</th>
                    <th>إجمالي التوريدات</th>
                    <th>المسدد له</th>
                    <th>المتبقي له (الرصيد)</th>
                    <th>عدد عمليات التوريد</th>
                    <th class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var s in Model)
                    {
                        var totalSupplied = s.SupplyOrders.Sum(o => o.TotalAmount);
                        var totalPaid = s.Payments.Sum(p => p.Amount);
                        var balance = totalSupplied - totalPaid;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center ms-2 text-primary fw-bold" style="width: 38px; height: 38px;">
                                        @(string.IsNullOrEmpty(s.Name) ? "م" : s.Name[0].ToString())
                                    </div>
                                    <div>
                                        <a href="@Url.Action("Details", "Suppliers", new { id = s.Id })" class="fw-bold text-dark text-decoration-none">
                                            @s.Name
                                        </a>
                                        @if (!string.IsNullOrEmpty(s.CompanyName))
                                        {
                                            <div class="text-muted small"><i class="bi bi-building ms-1"></i>@s.CompanyName</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div><i class="bi bi-telephone ms-1 text-secondary"></i>@s.PhoneNumber</div>
                                @if (!string.IsNullOrEmpty(s.WhatsAppNumber))
                                {
                                    <a href="https://wa.me/@(s.WhatsAppNumber.Replace("+", "").Replace(" ", ""))" target="_blank" class="badge bg-success-subtle text-success text-decoration-none small">
                                        <i class="bi bi-whatsapp ms-1"></i>واتساب
                                    </a>
                                }
                            </td>
                            <td class="fw-semibold">@totalSupplied.ToString("N0") ج.م</td>
                            <td class="text-success fw-semibold">@totalPaid.ToString("N0") ج.م</td>
                            <td>
                                @if (balance > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fs-6">
                                        له: @balance.ToString("N0") ج.م
                                    </span>
                                }
                                else if (balance < 0)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 fs-6">
                                        عليه: @(Math.Abs(balance).ToString("N0")) ج.م
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        خالص (0 ج.م)
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">@s.SupplyOrders.Count عملية</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a href="@Url.Action("Details", "Suppliers", new { id = s.Id })" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-journal-text ms-1"></i> كشف الحساب والتوريد
                                    </a>
                                    <form asp-controller="Suppliers" asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('هل أنت متاكد من حذف المورد (@s.Name) وكافة حركاته نهائياً من قاعدة البيانات؟');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف المورد">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-truck display-6 d-block text-secondary mb-2"></i>
                            لم يتم العثور على أي موردين. يمكنك إضافة مورد جديد الآن.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Supplier Modal -->
<div class="modal fade" id="addSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus ms-2"></i>إضافة مورد جديد</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">اسم المورد / المندوب <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" required placeholder="مثال: أحمد عبد الله" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">اسم الشركة أو التوكيل</label>
                            <input type="text" name="CompanyName" class="form-control" placeholder="مثال: شركة النور للأجهزة الذكية" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">رقم الهاتف <span class="text-danger">*</span></label>
                            <input type="tel" name="PhoneNumber" class="form-control" required placeholder="01xxxxxxxxx" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">رقم الواتساب</label>
                            <input type="tel" name="WhatsAppNumber" class="form-control" placeholder="01xxxxxxxxx" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">العنوان أو المقر</label>
                            <input type="text" name="Address" class="form-control" placeholder="مثال: القاهرة - العتبة - مول البستان" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">رصيد افتتاحي سابق له (إن وجد)</label>
                            <div class="input-group">
                                <input type="number" step="1" min="0" name="initialBalance" class="form-control" placeholder="0" />
                                <span class="input-group-text">ج.م</span>
                            </div>
                            <div class="form-text small">إذا كان له مستحقات قديمة قبل بدء استخدام النظام أدخلها هنا.</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">ملاحظات إضافية</label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="أي ملاحظات تخص التعامل مع المورد..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4">حفظ المورد</button>
                </div>
            </form>
        </div>
    </div>
</div>
