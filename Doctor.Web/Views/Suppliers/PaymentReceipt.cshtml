@model Doctor.Web.Models.Entities.SupplierPayment
@{
    ViewData["Title"] = $"سند صرف نقدية #{Model.Id}";
    Layout = null;
    var settings = ViewBag.Settings as Dictionary<string, string> ?? new();
    string storeName = settings.GetValueOrDefault("StoreName", "دكتور سنتر للأجهزة الذكية");
    string storePhone = settings.GetValueOrDefault("StorePhone", "01000000000");
    string storeAddress = settings.GetValueOrDefault("StoreAddress", "القاهرة، مصر");
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>سند صرف نقدية #@Model.Id - @Model.Supplier.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #212529;
            padding: 20px 0;
        }
        .receipt-container {
            max-width: 760px;
            margin: 0 auto;
            background: #fff;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            border: 2px solid #e9ecef;
        }
        .stamp-box {
            border: 2px dashed #6c757d;
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #adb5bd;
            font-size: 0.85rem;
            border-radius: 8px;
        }
        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
            .receipt-container {
                box-shadow: none;
                border: 1px solid #333;
                padding: 20px;
            }
        }
    </style>
</head>
<body>

<div class="container mb-3 no-print text-center">
    <button onclick="window.print()" class="btn btn-primary px-4 py-2 shadow-sm">
        <i class="bi bi-printer-fill ms-1"></i> طباعة سند الصرف
    </button>
    <a href="@Url.Action("Details", "Suppliers", new { id = Model.SupplierId })" class="btn btn-outline-secondary px-3 py-2 ms-2 shadow-sm">
        <i class="bi bi-arrow-right ms-1"></i> العودة لكشف حساب المورد
    </a>
</div>

<div class="receipt-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
        <div>
            <h4 class="fw-bold text-primary mb-1">@storeName</h4>
            <p class="text-muted small mb-0"><i class="bi bi-geo-alt ms-1"></i>@storeAddress &bull; <i class="bi bi-telephone ms-1"></i>@storePhone</p>
        </div>
        <div class="text-end">
            <h5 class="fw-bold mb-1">سند صرف نقدية</h5>
            <span class="badge bg-secondary font-monospace fs-6">سند رقم: #@Model.Id</span>
        </div>
    </div>

    <!-- Date & Info Bar -->
    <div class="row bg-light rounded-3 p-3 mb-4 g-2 small">
        <div class="col-6 col-md-3">
            <span class="text-muted d-block">التاريخ والوقت:</span>
            <strong>@Model.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</strong>
        </div>
        <div class="col-6 col-md-3">
            <span class="text-muted d-block">طريقة السداد:</span>
            <strong class="text-primary">@Model.PaymentMethod.ToString()</strong>
        </div>
        <div class="col-6 col-md-3">
            <span class="text-muted d-block">الرقم المرجعي:</span>
            <strong>@(Model.ReferenceNumber ?? "-")</strong>
        </div>
        <div class="col-6 col-md-3">
            <span class="text-muted d-block">رقم التوريد المرتبط:</span>
            <strong>@(Model.SupplyOrder != null ? Model.SupplyOrder.OrderNumber : "تحت الحساب")</strong>
        </div>
    </div>

    <!-- Body Information -->
    <div class="mb-4">
        <div class="row g-3">
            <div class="col-md-12">
                <div class="d-flex border-bottom pb-2">
                    <span class="text-muted" style="min-width: 140px;">يصرف إلى السيد/الشركة:</span>
                    <strong class="fs-6 text-dark">@Model.Supplier.Name @(!string.IsNullOrEmpty(Model.Supplier.CompanyName) ? $"({Model.Supplier.CompanyName})" : "")</strong>
                </div>
            </div>
            <div class="col-md-12">
                <div class="d-flex border-bottom pb-2 align-items-center">
                    <span class="text-muted" style="min-width: 140px;">مبلغ وقدره:</span>
                    <div class="bg-success-subtle text-success border border-success-subtle rounded px-3 py-1 fw-bold fs-5 font-monospace">
                        @Model.Amount.ToString("N0") ج.م
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="d-flex border-bottom pb-2">
                    <span class="text-muted" style="min-width: 140px;">وذلك عن / البيان:</span>
                    <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.Notes) ? "سداد دفعة توريد أجهزة تحت الحساب" : Model.Notes)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Signatures -->
    <div class="row mt-5 pt-4 g-4 text-center">
        <div class="col-4">
            <span class="fw-bold d-block mb-4">أمين الصندوق / المحاسب</span>
            <span class="text-muted small">..................................</span>
        </div>
        <div class="col-4">
            <div class="stamp-box">
                ختم المحل
            </div>
        </div>
        <div class="col-4">
            <span class="fw-bold d-block mb-4">المستلم (المورد أو مندوبه)</span>
            <span class="text-muted small">..................................</span>
        </div>
    </div>

    <div class="text-center text-muted small mt-4 pt-3 border-top">
        تم استخراج هذا السند إلكترونياً عبر منظومة دكتور لإدارة متاجر الهواتف
    </div>
</div>

</body>
</html>
