@model Doctor.Web.Models.Entities.Supplier
@{
    ViewData["Title"] = $"كشف حساب المورد: {Model.Name}";
    decimal totalSupplies = ViewBag.TotalSupplies ?? 0m;
    decimal totalPaid = ViewBag.TotalPaid ?? 0m;
    decimal balance = ViewBag.CurrentBalance ?? 0m;
    var brands = ViewBag.Brands as List<Doctor.Web.Models.Entities.Brand> ?? new();
    var products = ViewBag.Products as List<Doctor.Web.Models.Entities.Product> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Suppliers")">الموردين</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0"><i class="bi bi-person-badge text-primary ms-2"></i>@Model.Name</h3>
        @if (!string.IsNullOrEmpty(Model.CompanyName))
        {
            <span class="text-muted"><i class="bi bi-building ms-1"></i>@Model.CompanyName</span>
        }
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#supplyModal">
            <i class="bi bi-box-seam-fill"></i> توريد أجهزة جديدة للمخزون
        </button>
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#paymentModal">
            <i class="bi bi-cash-stack"></i> سداد دفعة / سند صرف
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editSupplierModal">
            <i class="bi bi-pencil"></i> تعديل
        </button>
        <form asp-controller="Suppliers" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('هل أنت متاكد من حذف هذا المورد (@Model.Name) وكافة توريداته ومدفوعاته نهائياً من النظام؟');" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-trash-fill"></i> حذف المورد
            </button>
        </form>
    </div>
</div>

<!-- Balance & Contact Overview -->
<div class="row g-3 mb-4">
    <div class="col-lg-4 col-md-6">
        <div class="card border-0 shadow-sm @(balance > 0 ? "bg-danger-subtle border-danger" : balance < 0 ? "bg-info-subtle border-info" : "bg-success-subtle border-success")">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">الرصيد المتبقي للمورد</span>
                        <h3 class="fw-bold mb-0 @(balance > 0 ? "text-danger" : balance < 0 ? "text-info" : "text-success")">
                            @balance.ToString("N0") <span class="fs-6 fw-normal">ج.م</span>
                        </h3>
                        <small class="fw-semibold">
                            @(balance > 0 ? "مستحق للمورد في ذمتنا" : balance < 0 ? "رصيد دائن لصالح المحل" : "الحساب خالص تماماً")
                        </small>
                    </div>
                    <div class="rounded-circle bg-white p-3 shadow-sm">
                        <i class="bi @(balance > 0 ? "bi-exclamation-triangle-fill text-danger" : "bi-check-circle-fill text-success") fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small">إجمالي قيمة التوريدات</span>
                        <h4 class="fw-bold mb-0 text-dark">@totalSupplies.ToString("N0") <span class="fs-6 fw-normal text-muted">ج.م</span></h4>
                        <span class="text-muted small">عدد الفواتير: @Model.SupplyOrders.Count</span>
                    </div>
                    <div class="rounded-circle bg-primary-subtle text-primary p-3">
                        <i class="bi bi-cart-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-12">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small">إجمالي المبالغ المسددة</span>
                        <h4 class="fw-bold mb-0 text-success">@totalPaid.ToString("N0") <span class="fs-6 fw-normal text-muted">ج.م</span></h4>
                        <span class="text-muted small">عدد سندات الصرف: @Model.Payments.Count</span>
                    </div>
                    <div class="rounded-circle bg-success-subtle text-success p-3">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Details Tabs -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white p-2">
        <ul class="nav nav-pills" id="supplierTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="orders-tab" data-bs-toggle="pill" data-bs-target="#orders-pane" type="button" role="tab">
                    <i class="bi bi-box-seam ms-1"></i> فواتير وعمليات التوريد (@Model.SupplyOrders.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="payments-tab" data-bs-toggle="pill" data-bs-target="#payments-pane" type="button" role="tab">
                    <i class="bi bi-cash-stack ms-1"></i> سجل الدفعات وسندات الصرف (@Model.Payments.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="info-tab" data-bs-toggle="pill" data-bs-target="#info-pane" type="button" role="tab">
                    <i class="bi bi-info-circle ms-1"></i> بيانات الاتصال والملاحظات
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="supplierTabsContent">
            <!-- Tab 1: Orders -->
            <div class="tab-pane fade show active" id="orders-pane" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>رقم الفاتورة</th>
                                <th>التاريخ والوقت</th>
                                <th>الأجهزة الموردة</th>
                                <th>إجمالي الفاتورة</th>
                                <th>المسدد منها</th>
                                <th>المتبقي</th>
                                <th>ملاحظات</th>
                                <th class="text-center" style="width: 110px;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SupplyOrders.Any())
                            {
                                foreach (var ord in Model.SupplyOrders.OrderByDescending(o => o.CreatedAt))
                                {
                                    var firstItem = ord.Items.FirstOrDefault();
                                    int prodId = firstItem?.ProductId ?? 0;
                                    int qty = firstItem?.Quantity ?? 1;
                                    decimal cost = firstItem?.CostPrice ?? ord.TotalAmount;
                                    decimal sell = firstItem?.SellingPrice ?? 0;
                                    string pMethod = ord.Payments.FirstOrDefault()?.PaymentMethod.ToString() ?? "Cash";

                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark font-monospace border">@ord.OrderNumber</span>
                                        </td>
                                        <td class="small text-muted">
                                            @ord.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")
                                        </td>
                                        <td>
                                            @if (ord.Items.Any())
                                            {
                                                foreach (var item in ord.Items)
                                                {
                                                    <div class="small">
                                                        <strong class="text-primary">@item.Product.Name</strong>
                                                        <span class="text-muted">(@item.Quantity جهاز &times; @item.CostPrice.ToString("N0") ج.م)</span>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@ord.Notes</span>
                                            }
                                        </td>
                                        <td class="fw-bold">@ord.TotalAmount.ToString("N0") ج.م</td>
                                        <td class="text-success">@ord.PaidAmount.ToString("N0") ج.م</td>
                                        <td>
                                            @if (ord.RemainingAmount > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">متبقي: @ord.RemainingAmount.ToString("N0") ج.م</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">مدفوعة بالكامل</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@(ord.Notes ?? "-")</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-secondary" 
                                                        onclick="openEditSupplyOrderModal(@ord.Id, '@ord.OrderNumber', @prodId, @qty, @cost, @sell, @ord.PaidAmount, '@pMethod', '@Html.Raw(Html.Encode(ord.Notes ?? ""))')"
                                                        title="تعديل الفاتورة">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-controller="Suppliers" asp-action="DeleteSupplyOrder" method="post" onsubmit="return confirm('هل أنت متأكد من حذف فاتورة التوريد رقم (@ord.OrderNumber)؟\n\n- سيتم خصم كمية الأجهزة من رصيد المخزن.\n- سيتم حذف أي دفعات مرتبطة بهذه الفاتورة وتحديث حساب المورد.');" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="orderId" value="@ord.Id" />
                                                    <button type="submit" class="btn btn-outline-danger" title="حذف الفاتورة">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">لا توجد عمليات توريد مسجلة حتى الآن لهذا المورد.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 2: Payments -->
            <div class="tab-pane fade" id="payments-pane" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>رقم السند</th>
                                <th>التاريخ</th>
                                <th>المبلغ المسدد</th>
                                <th>طريقة الدفع</th>
                                <th>الرقم المرجعي</th>
                                <th>ملاحظات</th>
                                <th class="text-center">إيصال الصرف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Payments.Any())
                            {
                                foreach (var pay in Model.Payments.OrderByDescending(p => p.CreatedAt))
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold text-secondary">#@pay.Id</td>
                                        <td class="small text-muted">@pay.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</td>
                                        <td class="fw-bold text-success fs-6">@pay.Amount.ToString("N0") ج.م</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@pay.PaymentMethod.ToString()</span>
                                        </td>
                                        <td class="small font-monospace">@(pay.ReferenceNumber ?? "-")</td>
                                        <td class="small text-muted">@(pay.Notes ?? "-")</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("PaymentReceipt", "Suppliers", new { id = pay.Id })" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-printer ms-1"></i> طباعة السند
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">لا توجد دفعات أو سندات صرف مسجلة لهذا المورد.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 3: Contact Info -->
            <div class="tab-pane fade p-3" id="info-pane" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-4">
                        <span class="text-muted small d-block">الهاتف</span>
                        <strong class="fs-6">@Model.PhoneNumber</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted small d-block">الواتساب</span>
                        <strong>@(Model.WhatsAppNumber ?? "غير مسجل")</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted small d-block">العنوان</span>
                        <strong>@(Model.Address ?? "غير مسجل")</strong>
                    </div>
                    <div class="col-md-12">
                        <span class="text-muted small d-block">ملاحظات</span>
                        <p class="text-muted mb-0">@(Model.Notes ?? "لا توجد ملاحظات")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Supply Devices (Multi-item Invoice) -->
<div class="modal fade" id="supplyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-box-seam ms-2"></i>فاتورة توريد أجهزة جديدة للمخزون من (@Model.Name)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Supply" method="post" id="supplyOrderForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="supplierId" value="@Model.Id" />
                <input type="hidden" name="itemsJson" id="supplyItemsJson" value="[]" />

                <div class="modal-body p-3 p-md-4">
                    <div class="alert alert-light border small mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-primary fs-5"></i>
                        <span>يمكنك إضافة عدة أجهزة في نفس الفاتورة. ابحث عن الجهاز واختره أو أدخل جهازاً جديداً، وحدد الكمية وسعر الشراء ثم اضغط <strong>(إضافة للفاتورة)</strong>.</span>
                    </div>

                    <!-- Step 1: Add Device Section -->
                    <div class="card border-primary border-opacity-25 bg-light-subtle mb-4">
                        <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold small"><i class="bi bi-plus-circle ms-1"></i> إضافة جهاز إلى الفاتورة</span>
                            <div class="d-flex gap-3 small">
                                <div class="form-check form-check-inline m-0">
                                    <input class="form-check-input" type="radio" name="supplyTypeRadio" id="supplyExistingRadio" value="existing" checked onchange="toggleSupplyType()">
                                    <label class="form-check-label text-white" for="supplyExistingRadio">جهاز موجود بالمحل</label>
                                </div>
                                <div class="form-check form-check-inline m-0">
                                    <input class="form-check-input" type="radio" name="supplyTypeRadio" id="supplyNewRadio" value="new" onchange="toggleSupplyType()">
                                    <label class="form-check-label text-white" for="supplyNewRadio">جهاز أو موديل جديد</label>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <!-- Existing Device Section with Live Search -->
                            <div id="existingProductSection" class="mb-3 position-relative">
                                <label class="form-label small fw-bold">ابحث بالاسم أو الموديل عن جهاز موجود <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                                    <input type="text" id="supplySearchInput" class="form-control" placeholder="اكتب اسم الجهاز أو الموديل للبحث الفوري..." autocomplete="off" oninput="filterSupplyDevices(this.value)" onfocus="showSupplyDeviceDropdown()" />
                                    <button type="button" class="btn btn-outline-secondary" onclick="clearSupplyDeviceSearch()" title="مسح">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>

                                <!-- Live Search Dropdown -->
                                <div id="supplySearchResults" class="list-group position-absolute w-100 shadow-lg border rounded-3 mt-1" style="max-height: 250px; overflow-y: auto; z-index: 1060; display: none;">
                                    @foreach (var p in products)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 supply-device-item"
                                                data-id="@p.Id"
                                                data-name="@p.Name @(!string.IsNullOrEmpty(p.Storage) ? $"({p.Storage} / {p.Ram})" : "")"
                                                data-cost="@p.PurchasePrice"
                                                data-price="@p.SellingPrice"
                                                data-stock="@p.StockQuantity"
                                                onclick="selectSupplyDevice(this)">
                                            <div>
                                                <strong class="text-primary d-block">@p.Name</strong>
                                                <small class="text-muted">@(!string.IsNullOrEmpty(p.Storage) ? $"{p.Storage} / {p.Ram} | " : "") تكلفة حالية: @p.PurchasePrice.ToString("N0") ج.م</small>
                                            </div>
                                            <span class="badge bg-light text-dark border">مخزون: @p.StockQuantity</span>
                                        </button>
                                    }
                                </div>

                                <!-- Selected Device Display Box -->
                                <div id="selectedDeviceBox" class="p-2 mt-2 bg-white border rounded d-none align-items-center justify-content-between">
                                    <div>
                                        <span class="text-muted small">الجهاز المحدد:</span>
                                        <strong id="selectedDeviceName" class="text-dark ms-2"></strong>
                                        <span id="selectedDeviceStockBadge" class="badge bg-info-subtle text-info border ms-2"></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="clearSupplyDeviceSelection()">
                                        <i class="bi bi-x-circle ms-1"></i> تغيير الجهاز
                                    </button>
                                </div>
                                <input type="hidden" id="selectedProductId" value="" />
                            </div>

                            <!-- New Device Section -->
                            <div id="newProductSection" class="p-3 bg-white border rounded-3 mb-3" style="display: none;">
                                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-phone ms-1"></i>بيانات الجهاز الجديد</h6>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">اسم الجهاز والموديل <span class="text-danger">*</span></label>
                                        <input type="text" id="newDeviceNameInput" class="form-control form-control-sm" placeholder="مثال: iPhone 15 Pro Max" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">الشركة المصنعة</label>
                                        <select id="newDeviceBrandSelect" class="form-select form-select-sm">
                                            <option value="">اختر الشركة...</option>
                                            @foreach (var b in brands)
                                            {
                                                <option value="@b.Id">@b.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">التخزين</label>
                                        <select id="newDeviceStorage" class="form-select form-select-sm">
                                            <option value="128GB">128GB</option>
                                            <option value="256GB">256GB</option>
                                            <option value="512GB">512GB</option>
                                            <option value="64GB">64GB</option>
                                            <option value="1TB">1TB</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">الرام</label>
                                        <select id="newDeviceRam" class="form-select form-select-sm">
                                            <option value="8GB">8GB</option>
                                            <option value="6GB">6GB</option>
                                            <option value="12GB">12GB</option>
                                            <option value="4GB">4GB</option>
                                            <option value="16GB">16GB</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">اللون</label>
                                        <input type="text" id="newDeviceColor" class="form-control form-control-sm" placeholder="أسود، أزرق..." />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">السيريال / IMEI (اختياري)</label>
                                        <input type="text" id="newDeviceImei" class="form-control form-control-sm font-monospace" placeholder="IMEI" />
                                    </div>
                                </div>
                            </div>

                            <!-- Device Quantity & Cost Row -->
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label small fw-bold">الكمية الموردة <span class="text-danger">*</span></label>
                                    <input type="number" id="supplyItemQuantity" class="form-control form-control-sm" value="1" min="1" oninput="calcItemSubtotal()" />
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label small fw-bold">سعر الشراء / التكلفة للقطعة <span class="text-danger">*</span></label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="1" min="1" id="supplyItemCostPrice" class="form-control" placeholder="0" oninput="calcItemSubtotal()" />
                                        <span class="input-group-text">ج.م</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label small fw-bold">سعر البيع المقترح في الكاشير</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="1" min="0" id="supplyItemSellingPrice" class="form-control" placeholder="0" />
                                        <span class="input-group-text">ج.م</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <button type="button" class="btn btn-primary btn-sm w-100 fw-bold py-2" onclick="addDeviceToInvoice()">
                                        <i class="bi bi-plus-circle-fill ms-1"></i> إضافة الجهاز للفاتورة
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Invoice Items Table -->
                    <div class="card border mb-4">
                        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span class="fw-bold small text-dark">
                                <i class="bi bi-card-checklist ms-1 text-success"></i> الأجهزة المضافة للفاتورة الحالية (<span id="invoiceItemsCount">0</span> أجهزة)
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small text-muted">إجمالي الفاتورة:</span>
                                <span class="badge bg-success fs-6 fw-bold" id="invoiceItemsSubtotal">0 ج.م</span>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>#</th>
                                            <th>اسم الجهاز / الموديل</th>
                                            <th class="text-center" style="width: 90px;">الكمية</th>
                                            <th style="width: 120px;">سعر التكلفة</th>
                                            <th style="width: 120px;">سعر البيع</th>
                                            <th style="width: 120px;">الإجمالي</th>
                                            <th class="text-center" style="width: 60px;">حذف</th>
                                        </tr>
                                    </thead>
                                    <tbody id="invoiceItemsTableBody">
                                        <tr id="emptyInvoiceItemsRow">
                                            <td colspan="7" class="text-center text-muted py-4 small">
                                                <i class="bi bi-inbox fs-4 d-block mb-1 text-secondary opacity-50"></i>
                                                لم يتم إضافة أي أجهزة للفاتورة بعد. قم باختيار الجهاز من الأعلى ثم اضغط "إضافة الجهاز للفاتورة".
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Financials & Payment -->
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-success">المسدد نقداً للمورد الآن</label>
                            <div class="input-group">
                                <input type="number" step="1" min="0" name="paidAmount" id="supplyPaidAmount" class="form-control" value="0" oninput="calcSupplyRemaining()" />
                                <span class="input-group-text">ج.م</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">طريقة الدفع</label>
                            <select name="paymentMethod" class="form-select">
                                <option value="Cash">كاش (نقدي من الدرج)</option>
                                <option value="Instapay">إنستاباي (InstaPay)</option>
                                <option value="VodafoneCash">محفظة إلكترونية</option>
                                <option value="Card">فيزا / بطاقة</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-danger">المتبقي في حساب المورد (آجل)</label>
                            <input type="text" id="supplyRemainingDisplay" class="form-control fw-bold bg-light text-danger" readonly value="0 ج.م" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold">ملاحظات الفاتورة</label>
                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="مثال: فاتورة توريد دفعة شتاء - خصم خاص..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3 justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" id="submitSupplyBtn" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" disabled>
                        <i class="bi bi-check2-circle ms-1"></i> حفظ وتأكيد فاتورة التوريد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

