@section Scripts {
<script>
    // Current invoice items array
    let currentInvoiceItems = [];

    function toggleSupplyType() {
        const isExisting = document.getElementById('supplyExistingRadio').checked;
        const existSec = document.getElementById('existingProductSection');
        const newSec = document.getElementById('newProductSection');
        const newNameInput = document.getElementById('newDeviceNameInput');

        existSec.style.display = isExisting ? 'block' : 'none';
        newSec.style.display = isExisting ? 'none' : 'block';
        if (newNameInput) newNameInput.required = !isExisting;

        if (!isExisting) {
            clearSupplyDeviceSelection();
        }
    }

    // Live search for devices
    function filterSupplyDevices(query) {
        query = (query || '').trim().toLowerCase();
        const resultsContainer = document.getElementById('supplySearchResults');
        const items = resultsContainer.querySelectorAll('.supply-device-item');
        let visibleCount = 0;

        items.forEach(item => {
            const name = (item.getAttribute('data-name') || '').toLowerCase();
            if (!query || name.includes(query)) {
                item.style.display = 'flex';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        resultsContainer.style.display = visibleCount > 0 ? 'block' : 'none';
    }

    function showSupplyDeviceDropdown() {
        const input = document.getElementById('supplySearchInput');
        filterSupplyDevices(input.value);
    }

    function clearSupplyDeviceSearch() {
        const input = document.getElementById('supplySearchInput');
        input.value = '';
        filterSupplyDevices('');
        input.focus();
    }

    function selectSupplyDevice(el) {
        const id = el.getAttribute('data-id');
        const name = el.getAttribute('data-name');
        const cost = el.getAttribute('data-cost');
        const price = el.getAttribute('data-price');
        const stock = el.getAttribute('data-stock');

        document.getElementById('selectedProductId').value = id;
        document.getElementById('selectedDeviceName').innerText = name;
        document.getElementById('selectedDeviceStockBadge').innerText = 'المخزون الحالي: ' + stock;
        document.getElementById('selectedDeviceBox').classList.remove('d-none');
        document.getElementById('selectedDeviceBox').classList.add('d-flex');

        document.getElementById('supplySearchInput').value = name;
        document.getElementById('supplySearchResults').style.display = 'none';

        document.getElementById('supplyItemCostPrice').value = cost || '';
        document.getElementById('supplyItemSellingPrice').value = price || '';
        document.getElementById('supplyItemQuantity').focus();
    }

    function clearSupplyDeviceSelection() {
        document.getElementById('selectedProductId').value = '';
        document.getElementById('selectedDeviceName').innerText = '';
        document.getElementById('selectedDeviceBox').classList.add('d-none');
        document.getElementById('selectedDeviceBox').classList.remove('d-flex');
        document.getElementById('supplySearchInput').value = '';
        document.getElementById('supplyItemCostPrice').value = '';
        document.getElementById('supplyItemSellingPrice').value = '';
    }

    // Close live search dropdown when clicking outside
    document.addEventListener('click', function (e) {
        const searchInput = document.getElementById('supplySearchInput');
        const resultsContainer = document.getElementById('supplySearchResults');
        if (searchInput && resultsContainer) {
            if (!searchInput.contains(e.target) && !resultsContainer.contains(e.target)) {
                resultsContainer.style.display = 'none';
            }
        }
    });

    function calcItemSubtotal() {
        // Live feedback if needed
    }

    // Add device to invoice
    function addDeviceToInvoice() {
        const isExisting = document.getElementById('supplyExistingRadio').checked;
        const qty = parseInt(document.getElementById('supplyItemQuantity').value) || 0;
        const cost = parseFloat(document.getElementById('supplyItemCostPrice').value) || 0;
        const sell = parseFloat(document.getElementById('supplyItemSellingPrice').value) || 0;

        if (qty <= 0) {
            alert('يرجى تحديد كمية صحيحة أكبر من صفر.');
            document.getElementById('supplyItemQuantity').focus();
            return;
        }

        if (cost <= 0) {
            alert('يرجى تحديد سعر شراء / تكلفة صحيح أكبر من صفر.');
            document.getElementById('supplyItemCostPrice').focus();
            return;
        }

        let item = {
            quantity: qty,
            costPrice: cost,
            sellingPrice: sell > 0 ? sell : Math.round(cost * 1.15),
            totalPrice: qty * cost
        };

        if (isExisting) {
            const prodId = document.getElementById('selectedProductId').value;
            const prodName = document.getElementById('selectedDeviceName').innerText;
            if (!prodId) {
                alert('يرجى اختيار جهاز من قائمة البحث أولاً.');
                document.getElementById('supplySearchInput').focus();
                return;
            }
            item.productId = parseInt(prodId);
            item.name = prodName;
            item.isNew = false;
        } else {
            const newName = document.getElementById('newDeviceNameInput').value.trim();
            if (!newName) {
                alert('يرجى كتابة اسم وموديل الجهاز الجديد.');
                document.getElementById('newDeviceNameInput').focus();
                return;
            }
            const brandId = document.getElementById('newDeviceBrandSelect').value;
            item.productId = null;
            item.name = newName;
            item.brandId = brandId ? parseInt(brandId) : null;
            item.storage = document.getElementById('newDeviceStorage').value;
            item.ram = document.getElementById('newDeviceRam').value;
            item.color = document.getElementById('newDeviceColor').value.trim();
            item.imei = document.getElementById('newDeviceImei').value.trim();
            item.isNew = true;
        }

        currentInvoiceItems.push(item);
        renderInvoiceItemsTable();

        // Reset input fields for next device
        clearSupplyDeviceSelection();
        if (!isExisting) {
            document.getElementById('newDeviceNameInput').value = '';
            document.getElementById('newDeviceColor').value = '';
            document.getElementById('newDeviceImei').value = '';
        }
        document.getElementById('supplyItemQuantity').value = 1;
        document.getElementById('supplyItemCostPrice').value = '';
        document.getElementById('supplyItemSellingPrice').value = '';
        if (isExisting) {
            document.getElementById('supplySearchInput').focus();
        }
    }

    function removeInvoiceItem(index) {
        currentInvoiceItems.splice(index, 1);
        renderInvoiceItemsTable();
    }

    function renderInvoiceItemsTable() {
        const tbody = document.getElementById('invoiceItemsTableBody');
        const countEl = document.getElementById('invoiceItemsCount');
        const subtotalEl = document.getElementById('invoiceItemsSubtotal');
        const jsonInput = document.getElementById('supplyItemsJson');
        const submitBtn = document.getElementById('submitSupplyBtn');

        if (!currentInvoiceItems || currentInvoiceItems.length === 0) {
            tbody.innerHTML = `
                <tr id="emptyInvoiceItemsRow">
                    <td colspan="7" class="text-center text-muted py-4 small">
                        <i class="bi bi-inbox fs-4 d-block mb-1 text-secondary opacity-50"></i>
                        لم يتم إضافة أي أجهزة للفاتورة بعد. قم باختيار الجهاز من الأعلى ثم اضغط "إضافة الجهاز للفاتورة".
                    </td>
                </tr>
            `;
            countEl.innerText = '0';
            subtotalEl.innerText = '0 ج.م';
            jsonInput.value = '[]';
            submitBtn.disabled = true;
            calcSupplyRemaining();
            return;
        }

        let html = '';
        let totalSum = 0;
        let totalDevices = 0;

        currentInvoiceItems.forEach((item, idx) => {
            totalSum += item.totalPrice;
            totalDevices += item.quantity;
            html += `
                <tr>
                    <td class="text-muted small">${idx + 1}</td>
                    <td>
                        <strong class="text-primary">${item.name}</strong>
                        ${item.isNew ? '<span class="badge bg-success-subtle text-success border me-1 small">جديد</span>' : ''}
                        ${item.storage ? `<span class="text-muted small">(${item.storage}${item.ram ? ' / ' + item.ram : ''})</span>` : ''}
                    </td>
                    <td class="text-center fw-bold">${item.quantity}</td>
                    <td><span class="font-monospace">${item.costPrice.toLocaleString('en-US')}</span> ج.م</td>
                    <td><span class="font-monospace text-muted">${item.sellingPrice.toLocaleString('en-US')}</span> ج.م</td>
                    <td class="fw-bold text-success"><span class="font-monospace">${item.totalPrice.toLocaleString('en-US')}</span> ج.م</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm p-1 px-2" onclick="removeInvoiceItem(${idx})" title="حذف من الفاتورة">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </td>
                </tr>
            `;
        });

        tbody.innerHTML = html;
        countEl.innerText = totalDevices;
        subtotalEl.innerText = totalSum.toLocaleString('en-US') + ' ج.م';
        jsonInput.value = JSON.stringify(currentInvoiceItems);
        submitBtn.disabled = false;

        calcSupplyRemaining();
    }

    function calcSupplyRemaining() {
        let total = 0;
        currentInvoiceItems.forEach(i => total += i.totalPrice);
        const paid = parseFloat(document.getElementById('supplyPaidAmount').value) || 0;
        const rem = Math.max(0, total - paid);
        document.getElementById('supplyRemainingDisplay').value = rem.toLocaleString('en-US') + ' ج.م';
    }

    function openEditSupplyOrderModal(orderId, orderNum, productId, quantity, costPrice, sellingPrice, paidAmount, paymentMethod, notes) {
        document.getElementById('editSupplyOrderId').value = orderId;
        document.getElementById('editSupplyOrderNumDisplay').innerText = orderNum;
        document.getElementById('editSupplyProductSelect').value = productId > 0 ? productId : '';
        document.getElementById('editSupplyQuantity').value = quantity;
        document.getElementById('editSupplyCostPrice').value = costPrice;
        document.getElementById('editSupplySellingPrice').value = sellingPrice;
        document.getElementById('editSupplyPaidAmount').value = paidAmount;
        document.getElementById('editSupplyPaymentMethod').value = paymentMethod || 'Cash';
        document.getElementById('editSupplyNotes').value = notes || '';

        calcEditSupplyTotal();

        var modal = new bootstrap.Modal(document.getElementById('editSupplyOrderModal'));
        modal.show();
    }

    function onEditSupplyProductChanged() {
        const select = document.getElementById('editSupplyProductSelect');
        const opt = select.options[select.selectedIndex];
        if (opt && opt.value) {
            const cost = opt.getAttribute('data-cost');
            const price = opt.getAttribute('data-price');
            if (cost) document.getElementById('editSupplyCostPrice').value = cost;
            if (price) document.getElementById('editSupplySellingPrice').value = price;
        }
        calcEditSupplyTotal();
    }

    function calcEditSupplyTotal() {
        const qty = parseFloat(document.getElementById('editSupplyQuantity').value) || 0;
        const cost = parseFloat(document.getElementById('editSupplyCostPrice').value) || 0;
        const total = qty * cost;
        document.getElementById('editSupplyTotalAmountDisplay').value = total.toLocaleString('en-US') + ' ج.م';
        calcEditSupplyRemaining();
    }

    function calcEditSupplyRemaining() {
        const qty = parseFloat(document.getElementById('editSupplyQuantity').value) || 0;
        const cost = parseFloat(document.getElementById('editSupplyCostPrice').value) || 0;
        const total = qty * cost;
        const paid = parseFloat(document.getElementById('editSupplyPaidAmount').value) || 0;
        const rem = Math.max(0, total - paid);
        document.getElementById('editSupplyRemainingDisplay').value = rem.toLocaleString('en-US') + ' ج.م';
    }
</script>
}
