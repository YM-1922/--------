                        </div>

                        <div class="col-md-4 mt-3">
                            <label class="form-label small fw-bold text-success">المسدد نقداً للمورد</label>
                            <div class="input-group">
                                <input type="number" step="1" min="0" name="paidAmount" id="editSupplyPaidAmount" class="form-control" oninput="calcEditSupplyRemaining()" />
                                <span class="input-group-text">ج.م</span>
                            </div>
                        </div>
                        <div class="col-md-4 mt-3">
                            <label class="form-label small fw-bold">طريقة الدفع</label>
                            <select name="paymentMethod" id="editSupplyPaymentMethod" class="form-select">
