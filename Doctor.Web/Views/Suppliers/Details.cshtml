@model Doctor.Web.Models.Entities.Supplier
@{
    ViewData["Title"] = $"كشف حساب المورد: {Model.Name}";
    decimal totalSupplies = ViewBag.TotalSupplies ?? 0m;
    decimal totalPaid = ViewBag.TotalPaid ?? 0m;
    decimal balance = ViewBag.CurrentBalance ?? 0m;
    var brands = ViewBag.Brands as List<Doctor.Web.Models.Entities.Brand> ?? new();
    var products = ViewBag.Products as List<Doctor.Web.Models.Entities.Product> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Suppliers")">الموردين</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0"><i class="bi bi-person-badge text-primary ms-2"></i>@Model.Name</h3>
        @if (!string.IsNullOrEmpty(Model.CompanyName))
        {
            <span class="text-muted"><i class="bi bi-building ms-1"></i>@Model.CompanyName</span>
        }
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#supplyModal">
            <i class="bi bi-box-seam-fill"></i> توريد أجهزة جديدة للمخزون
        </button>
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#paymentModal">
            <i class="bi bi-cash-stack"></i> سداد دفعة / سند صرف
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editSupplierModal">
            <i class="bi bi-pencil"></i> تعديل
        </button>
        <form asp-controller="Suppliers" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('هل أنت متاكد من حذف هذا المورد (@Model.Name) وكافة توريداته ومدفوعاته نهائياً من النظام؟');" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-trash-fill"></i> حذف المورد
            </button>
        </form>
    </div>
</div>

<!-- Balance & Contact Overview -->
<div class="row g-3 mb-4">
    <div class="col-lg-4 col-md-6">
        <div class="card border-0 shadow-sm @(balance > 0 ? "bg-danger-subtle border-danger" : balance < 0 ? "bg-info-subtle border-info" : "bg-success-subtle border-success")">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold">الرصيد المتبقي للمورد</span>
                        <h3 class="fw-bold mb-0 @(balance > 0 ? "text-danger" : balance < 0 ? "text-info" : "text-success")">
                            @balance.ToString("N0") <span class="fs-6 fw-normal">ج.م</span>
                        </h3>
                        <small class="fw-semibold">
                            @(balance > 0 ? "مستحق للمورد في ذمتنا" : balance < 0 ? "رصيد دائن لصالح المحل" : "الحساب خالص تماماً")
                        </small>
                    </div>
                    <div class="rounded-circle bg-white p-3 shadow-sm">
                        <i class="bi @(balance > 0 ? "bi-exclamation-triangle-fill text-danger" : "bi-check-circle-fill text-success") fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small">إجمالي قيمة التوريدات</span>
                        <h4 class="fw-bold mb-0 text-dark">@totalSupplies.ToString("N0") <span class="fs-6 fw-normal text-muted">ج.م</span></h4>
                        <span class="text-muted small">عدد الفواتير: @Model.SupplyOrders.Count</span>
                    </div>
                    <div class="rounded-circle bg-primary-subtle text-primary p-3">
                        <i class="bi bi-cart-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-12">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small">إجمالي المبالغ المسددة</span>
                        <h4 class="fw-bold mb-0 text-success">@totalPaid.ToString("N0") <span class="fs-6 fw-normal text-muted">ج.م</span></h4>
                        <span class="text-muted small">عدد سندات الصرف: @Model.Payments.Count</span>
                    </div>
                    <div class="rounded-circle bg-success-subtle text-success p-3">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Details Tabs -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white p-2">
        <ul class="nav nav-pills" id="supplierTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="orders-tab" data-bs-toggle="pill" data-bs-target="#orders-pane" type="button" role="tab">
                    <i class="bi bi-box-seam ms-1"></i> فواتير وعمليات التوريد (@Model.SupplyOrders.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="payments-tab" data-bs-toggle="pill" data-bs-target="#payments-pane" type="button" role="tab">
                    <i class="bi bi-cash-stack ms-1"></i> سجل الدفعات وسندات الصرف (@Model.Payments.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="info-tab" data-bs-toggle="pill" data-bs-target="#info-pane" type="button" role="tab">
                    <i class="bi bi-info-circle ms-1"></i> بيانات الاتصال والملاحظات
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="supplierTabsContent">
            <!-- Tab 1: Orders -->
            <div class="tab-pane fade show active" id="orders-pane" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>رقم الفاتورة</th>
                                <th>التاريخ والوقت</th>
                                <th>الأجهزة الموردة</th>
                                <th>إجمالي الفاتورة</th>
                                <th>المسدد منها</th>
                                <th>المتبقي</th>
                                <th>ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SupplyOrders.Any())
                            {
                                foreach (var ord in Model.SupplyOrders.OrderByDescending(o => o.CreatedAt))
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark font-monospace border">@ord.OrderNumber</span>
                                        </td>
                                        <td class="small text-muted">
                                            @ord.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")
                                        </td>
                                        <td>
                                            @if (ord.Items.Any())
                                            {
                                                foreach (var item in ord.Items)
                                                {
                                                    <div class="small">
                                                        <strong class="text-primary">@item.Product.Name</strong>
                                                        <span class="text-muted">(@item.Quantity جهاز &times; @item.CostPrice.ToString("N0") ج.م)</span>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@ord.Notes</span>
                                            }
                                        </td>
                                        <td class="fw-bold">@ord.TotalAmount.ToString("N0") ج.م</td>
                                        <td class="text-success">@ord.PaidAmount.ToString("N0") ج.م</td>
                                        <td>
                                            @if (ord.RemainingAmount > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">متبقي: @ord.RemainingAmount.ToString("N0") ج.م</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">مدفوعة بالكامل</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@(ord.Notes ?? "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">لا توجد عمليات توريد مسجلة حتى الآن لهذا المورد.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 2: Payments -->
            <div class="tab-pane fade" id="payments-pane" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>رقم السند</th>
                                <th>التاريخ</th>
                                <th>المبلغ المسدد</th>
                                <th>طريقة الدفع</th>
                                <th>الرقم المرجعي</th>
                                <th>ملاحظات</th>
                                <th class="text-center">إيصال الصرف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Payments.Any())
                            {
                                foreach (var pay in Model.Payments.OrderByDescending(p => p.CreatedAt))
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold text-secondary">#@pay.Id</td>
                                        <td class="small text-muted">@pay.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</td>
                                        <td class="fw-bold text-success fs-6">@pay.Amount.ToString("N0") ج.م</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@pay.PaymentMethod.ToString()</span>
                                        </td>
                                        <td class="small font-monospace">@(pay.ReferenceNumber ?? "-")</td>
                                        <td class="small text-muted">@(pay.Notes ?? "-")</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("PaymentReceipt", "Suppliers", new { id = pay.Id })" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-printer ms-1"></i> طباعة السند
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">لا توجد دفعات أو سندات صرف مسجلة لهذا المورد.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 3: Contact Info -->
            <div class="tab-pane fade p-3" id="info-pane" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-4">
                        <span class="text-muted small d-block">الهاتف</span>
                        <strong class="fs-6">@Model.PhoneNumber</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted small d-block">الواتساب</span>
                        <strong>@(Model.WhatsAppNumber ?? "غير مسجل")</strong>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted small d-block">العنوان</span>
                        <strong>@(Model.Address ?? "غير مسجل")</strong>
                    </div>
                    <div class="col-md-12">
                        <span class="text-muted small d-block">ملاحظات</span>
                        <p class="text-muted mb-0">@(Model.Notes ?? "لا توجد ملاحظات")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Supply New Devices -->
<div class="modal fade" id="supplyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-box-seam ms-2"></i>توريد أجهزة جديدة للمخزون من (@Model.Name)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Supply" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="supplierId" value="@Model.Id" />
                <div class="modal-body p-3">
                    <div class="alert alert-light border small mb-3">
                        <i class="bi bi-info-circle text-primary ms-1"></i>
                        بمجرد حفظ التوريد، سيتم إضافة كمية الأجهزة فوراً لمخزون المحل وستظهر في الكاشير للبيع، وسيتم تحديث رصيد المورد وحسابه تلقائياً.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">نوع التوريد:</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="supplyTypeRadio" id="supplyExistingRadio" value="existing" checked onchange="toggleSupplyType()">
                                <label class="form-check-label" for="supplyExistingRadio">
                                    جهاز موجود بالفعل بالمحل
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="supplyTypeRadio" id="supplyNewRadio" value="new" onchange="toggleSupplyType()">
                                <label class="form-check-label" for="supplyNewRadio">
                                    جهاز أو موديل جديد تماماً
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Existing Product Section -->
                    <div id="existingProductSection" class="mb-3">
                        <label class="form-label small fw-bold">اختر الجهاز الموجود بالمخزون <span class="text-danger">*</span></label>
                        <select name="productId" id="existingProductSelect" class="form-select" onchange="onExistingProductSelected()">
                            <option value="">-- اختر الجهاز المطلوب زيادة مخزونه --</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.Id" data-cost="@p.PurchasePrice" data-price="@p.SellingPrice">
                                    @p.Name @(!string.IsNullOrEmpty(p.Storage) ? $"({p.Storage} / {p.Ram})" : "") - مخزون حالي: @p.StockQuantity (التكلفة الحالية: @p.PurchasePrice.ToString("N0") ج.م)
                                </option>
                            }
                        </select>
                    </div>

                    <!-- New Product Section -->
                    <div id="newProductSection" class="p-3 bg-light rounded-3 mb-3" style="display: none;">
                        <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-phone ms-1"></i>بيانات الجهاز الجديد</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">اسم الجهاز والموديل <span class="text-danger">*</span></label>
                                <input type="text" name="newDeviceName" id="newDeviceNameInput" class="form-control form-control-sm" placeholder="مثال: iPhone 15 Pro Max" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">الشركة المصنعة <span class="text-danger">*</span></label>
                                <select name="brandId" class="form-select form-select-sm">
                                    <option value="">اختر الشركة...</option>
                                    @foreach (var b in brands)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">مساحة التخزين</label>
                                <select name="storage" class="form-select form-select-sm">
                                    <option value="128GB">128GB</option>
                                    <option value="256GB">256GB</option>
                                    <option value="512GB">512GB</option>
                                    <option value="64GB">64GB</option>
                                    <option value="1TB">1TB</option>
                                    <option value="32GB">32GB</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">الرام</label>
                                <select name="ram" class="form-select form-select-sm">
                                    <option value="8GB">8GB</option>
                                    <option value="6GB">6GB</option>
                                    <option value="12GB">12GB</option>
                                    <option value="4GB">4GB</option>
                                    <option value="16GB">16GB</option>
                                    <option value="3GB">3GB</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">اللون</label>
                                <input type="text" name="color" class="form-control form-control-sm" placeholder="مثال: أسود، أزرق، تيتانيوم" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">السيريال أو الـ IMEI (اختياري)</label>
                                <input type="text" name="imei" class="form-control form-control-sm font-monospace" placeholder="IMEI1 / Serial Number" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">صورة الجهاز</label>
                                <input type="file" name="imageFile" accept="image/*" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>

                    <!-- Supply Quantities and Pricing -->
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">الكمية الموردة <span class="text-danger">*</span></label>
                            <input type="number" name="quantity" id="supplyQuantity" class="form-control" value="1" min="1" required oninput="calcSupplyTotal()" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">سعر الشراء (التكلفة الجديدة) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="1" min="0" name="costPrice" id="supplyCostPrice" class="form-control" required oninput="calcSupplyTotal()" placeholder="0" />
                                <span class="input-group-text">ج.م</span>
                            </div>
                            <div id="avgPriceHint" class="text-primary small mt-1" style="display: none; font-size: 0.73rem;"></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">سعر البيع في الكاشير</label>
                            <div class="input-group">
                                <input type="number" step="1" min="0" name="sellingPrice" id="supplySellingPrice" class="form-control" placeholder="0" />
                                <span class="input-group-text">ج.م</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-primary">إجمالي فاتورة التوريد</label>
                            <div class="input-group">
                                <input type="text" id="supplyTotalAmountDisplay" class="form-control fw-bold bg-light text-primary" readonly value="0 ج.م" />
                            </div>
                        </div>

                        <div class="col-md-4 mt-3">
                            <label class="form-label small fw-bold text-success">المسدد نقداً للمورد الآن</label>
                            <div class="input-group">
                                <input type="number" step="1" min="0" name="paidAmount" id="supplyPaidAmount" class="form-control" value="0" oninput="calcSupplyRemaining()" />
                                <span class="input-group-text">ج.م</span>
                            </div>
                        </div>
                        <div class="col-md-4 mt-3">
                            <label class="form-label small fw-bold">طريقة الدفع</label>
                            <select name="paymentMethod" class="form-select">
                                <option value="Cash">كاش (نقدي من الدرج)</option>
                                <option value="Instapay">إنستاباي (InstaPay)</option>
                                <option value="VodafoneCash">محفظة إلكترونية</option>
                                <option value="Card">فيزا / بطاقة</option>
                            </select>
                        </div>
                        <div class="col-md-4 mt-3">
                            <label class="form-label small fw-bold text-danger">المتبقي في حساب المورد (آجل)</label>
                            <input type="text" id="supplyRemainingDisplay" class="form-control fw-bold bg-light text-danger" readonly value="0 ج.م" />
                        </div>

                        <div class="col-md-12 mt-2">
                            <label class="form-label small fw-bold">ملاحظات التوريد</label>
                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="مثال: فاتورة توريد رقم 104 - توريد دفعة شتاء..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success btn-sm px-4">
                        <i class="bi bi-check2-circle ms-1"></i> تأكيد التوريد والإضافة للمخزون
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Payment / Sannad Sarf -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-cash-stack ms-2"></i>سداد دفعة / سند صرف للمورد (@Model.Name)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RecordPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="supplierId" value="@Model.Id" />
                <div class="modal-body p-3">
                    <div class="mb-3 text-center p-2 rounded-3 bg-light border">
                        <span class="text-muted small d-block">الرصيد الحالي المستحق للمورد</span>
                        <h4 class="fw-bold text-danger mb-0">@balance.ToString("N0") ج.م</h4>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">مبلغ السداد <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" step="1" min="1" name="amount" class="form-control form-control-lg fw-bold text-success" required placeholder="0" value="@(balance > 0 ? balance : 0)" />
                            <span class="input-group-text">ج.م</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">طريقة السداد <span class="text-danger">*</span></label>
                        <select name="paymentMethod" class="form-select">
                            <option value="Cash">كاش (نقدي من الدرج)</option>
                            <option value="Instapay">إنستاباي (InstaPay)</option>
                            <option value="VodafoneCash">محفظة إلكترونية</option>
                            <option value="BankTransfer">تحويل بنكي</option>
                            <option value="Card">فيزا / بطاقة</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">الرقم المرجعي / رقم الشيك أو التحويل</label>
                        <input type="text" name="referenceNumber" class="form-control" placeholder="مثال: REF-99214 أو رقم إيصال التحويل" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">ملاحظات وبيان الصرف</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="دفعة تحت الحساب / سداد جزء من فواتير التوريد"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-printer ms-1"></i> تسجيل وطباعة السند
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Supplier Details -->
<div class="modal fade" id="editSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square ms-2"></i>تعديل بيانات المورد</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body p-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">اسم المورد</label>
                            <input type="text" name="Name" class="form-control" required value="@Model.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">الشركة أو التوكيل</label>
                            <input type="text" name="CompanyName" class="form-control" value="@Model.CompanyName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">الهاتف</label>
                            <input type="tel" name="PhoneNumber" class="form-control" required value="@Model.PhoneNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">الواتساب</label>
                            <input type="tel" name="WhatsAppNumber" class="form-control" value="@Model.WhatsAppNumber" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">العنوان</label>
                            <input type="text" name="Address" class="form-control" value="@Model.Address" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">ملاحظات</label>
                            <textarea name="Notes" class="form-control" rows="2">@Model.Notes</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-2">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-dark btn-sm px-4">تحديث البيانات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleSupplyType() {
        const isExisting = document.getElementById('supplyExistingRadio').checked;
        const existSec = document.getElementById('existingProductSection');
        const newSec = document.getElementById('newProductSection');
        const existSelect = document.getElementById('existingProductSelect');
        const newNameInput = document.getElementById('newDeviceNameInput');

        existSec.style.display = isExisting ? 'block' : 'none';
        newSec.style.display = isExisting ? 'none' : 'block';
        existSelect.disabled = !isExisting;
        if (newNameInput) newNameInput.required = !isExisting;

        if (isExisting) {
            onExistingProductSelected();
        } else {
            document.getElementById('supplyCostPrice').value = '';
            document.getElementById('supplySellingPrice').value = '';
            calcSupplyTotal();
        }
    }

    function onExistingProductSelected() {
        const select = document.getElementById('existingProductSelect');
        const opt = select.options[select.selectedIndex];
        if (opt && opt.value) {
            const cost = opt.getAttribute('data-cost');
            const price = opt.getAttribute('data-price');
            document.getElementById('supplyCostPrice').value = cost || 0;
            document.getElementById('supplySellingPrice').value = price || 0;
        }
        calcSupplyTotal();
    }

    function calcSupplyTotal() {
        const qty = parseFloat(document.getElementById('supplyQuantity').value) || 0;
        const cost = parseFloat(document.getElementById('supplyCostPrice').value) || 0;
        const total = qty * cost;
        document.getElementById('supplyTotalAmountDisplay').value = total.toLocaleString('en-US') + ' ج.م';

        // Calculate and display average price hint if an existing product is selected
        const isExisting = document.getElementById('supplyExistingRadio').checked;
        const select = document.getElementById('existingProductSelect');
        const hintEl = document.getElementById('avgPriceHint');
        if (isExisting && select && select.selectedIndex > 0) {
            const opt = select.options[select.selectedIndex];
            const oldCost = parseFloat(opt.getAttribute('data-cost')) || 0;
            if (oldCost > 0) {
                const avg = Math.round(((oldCost + cost) / 2) * 100) / 100;
                hintEl.style.display = 'block';
                hintEl.innerHTML = `<i class="bi bi-calculator ms-1"></i>متوسط التكلفة: (${oldCost} + ${cost}) ÷ 2 = <strong>${avg} ج.م</strong>`;
            } else {
                hintEl.style.display = 'none';
            }
        } else {
            if (hintEl) hintEl.style.display = 'none';
        }

        calcSupplyRemaining();
    }

    function calcSupplyRemaining() {
        const qty = parseFloat(document.getElementById('supplyQuantity').value) || 0;
        const cost = parseFloat(document.getElementById('supplyCostPrice').value) || 0;
        const total = qty * cost;
        const paid = parseFloat(document.getElementById('supplyPaidAmount').value) || 0;
        const rem = Math.max(0, total - paid);
        document.getElementById('supplyRemainingDisplay').value = rem.toLocaleString('en-US') + ' ج.م';
    }
</script>
}
