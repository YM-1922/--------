@model List<Doctor.Web.Models.Entities.Customer>
@{
    ViewData["Title"] = "سجل العملاء والحسابات والمديونيات";
    bool onlyDebt = ViewBag.OnlyDebt == true;
    int totalCount = ViewBag.TotalCustomersCount ?? Model.Count;
    int debtCount = ViewBag.DebtCustomersCount ?? 0;
    decimal totalDebt = ViewBag.TotalDebtAmount ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary ms-2"></i>سجل العملاء والحسابات والمديونيات</h3>
        <p class="text-muted small mb-0">متابعة حسابات العملاء، الفواتير، الديون المعلقة ومبيعات الآجل والجملة</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#createCustomerModal">
            <i class="bi bi-person-plus-fill"></i> إضافة عميل جديد
        </button>
        <a href="@Url.Action("Pos", "Sales")" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-cart-plus ms-1"></i> فتح الكاشير (POS)
        </a>
    </div>
</div>

<!-- Financial Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-end border-primary border-4 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small d-block mb-1">إجمالي العملاء المسجلين</span>
                    <strong class="fs-4 text-dark">@totalCount</strong>
                </div>
                <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-end border-danger border-4 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small d-block mb-1">عملاء عليهم حسابات آجلة (مدينون)</span>
                    <strong class="fs-4 text-danger">@debtCount عميل</strong>
                </div>
                <div class="rounded-circle bg-danger-subtle text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-clock-history fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-end border-warning border-4 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small d-block mb-1">إجمالي المديونيات المستحقة للسنتر</span>
                    <strong class="fs-4 text-warning-emphasis">@totalDebt.ToString("N2") ج.م</strong>
                </div>
                <div class="rounded-circle bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-cash-stack fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search Bar -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="btn-group btn-group-sm" role="group">
                <a href="@Url.Action("Index", "Customers", new { search = ViewBag.Search })" class="btn @(!onlyDebt ? "btn-primary" : "btn-outline-secondary")">
                    جميع العملاء (@totalCount)
                </a>
                <a href="@Url.Action("Index", "Customers", new { search = ViewBag.Search, onlyDebt = true })" class="btn @(onlyDebt ? "btn-danger" : "btn-outline-danger")">
                    <i class="bi bi-exclamation-circle ms-1"></i> العملاء المدينين فقط (@debtCount)
                </a>
            </div>

            <form method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 450px;">
                @if (onlyDebt)
                {
                    <input type="hidden" name="onlyDebt" value="true" />
                }
                <input type="text" name="search" class="form-control form-control-sm" placeholder="بحث بالاسم، الهاتف، أو ملاحظات العميل..." value="@ViewBag.Search" />
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-search"></i>
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a href="@Url.Action("Index", "Customers", new { onlyDebt = onlyDebt ? "true" : null })" class="btn btn-outline-secondary btn-sm" title="إلغاء البحث">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </form>
        </div>
    </div>
</div>

<!-- Customers Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th class="ps-3">اسم العميل</th>
                    <th>رقم الهاتف</th>
                    <th>الواتساب</th>
                    <th>عدد الفواتير</th>
                    <th>إجمالي المشتريات</th>
                    <th>المديونية / الحساب المتبقي</th>
                    <th>تاريخ التسجيل</th>
                    <th class="pe-3 text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var c in Model)
                    {
                        decimal customerSalesTotal = c.Sales.Where(s => s.Status == Doctor.Web.Models.Entities.SaleStatus.Completed).Sum(s => s.TotalAmount);
                        decimal customerDebt = c.Sales.Where(s => s.Status == Doctor.Web.Models.Entities.SaleStatus.Completed).Sum(s => s.RemainingAmount);

                        <tr class="@(customerDebt > 0 ? "table-danger-subtle" : "")">
                            <td class="ps-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle @(customerDebt > 0 ? "bg-danger text-white" : "bg-primary-subtle text-primary") fw-bold d-flex align-items-center justify-content-center ms-2" style="width: 38px; height: 38px;">
                                        @c.Name.FirstOrDefault()
                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">@c.Name</strong>
                                        @if (!string.IsNullOrEmpty(c.Notes))
                                        {
                                            <span class="badge bg-light text-muted border small" style="font-size: 0.7rem;">@c.Notes</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="font-monospace">
                                @if (c.PhoneNumber != "بدون هاتف")
                                {
                                    <a href="tel:@c.PhoneNumber" class="text-decoration-none fw-bold text-dark">@c.PhoneNumber</a>
                                }
                                else
                                {
                                    <span class="text-muted small">بدون هاتف</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.WhatsAppNumber) && c.WhatsAppNumber != "بدون هاتف")
                                {
                                    <a href="https://wa.me/@c.WhatsAppNumber" target="_blank" class="text-success text-decoration-none font-monospace small fw-bold">
                                        <i class="bi bi-whatsapp ms-1"></i>@c.WhatsAppNumber
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@c.Sales.Count فاتورة</span>
                            </td>
                            <td class="fw-bold">
                                @customerSalesTotal.ToString("N2") ج.م
                            </td>
                            <td>
                                @if (customerDebt > 0)
                                {
                                    <span class="badge bg-danger py-2 px-3 fw-bold fs-6">
                                        <i class="bi bi-exclamation-triangle-fill ms-1"></i> متبقي عليه: @customerDebt.ToString("N2") ج.م
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success py-2 px-2 fw-bold">
                                        <i class="bi bi-check-circle-fill ms-1"></i> الحساب خالص
                                    </span>
                                }
                            </td>
                            <td class="small text-muted">@c.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td class="pe-3 text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a href="@Url.Action("Details", "Customers", new { id = c.Id })" class="btn btn-sm btn-primary py-1 px-2 d-flex align-items-center gap-1 shadow-sm" title="فتح كشف الحساب">
                                        <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                                        <span>كشف الحساب</span>
                                    </a>
                                    <form asp-controller="Customers" asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('هل أنت متاكد من حذف العميل (@c.Name) نهائياً من قاعدة البيانات؟');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="حذف العميل">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-6 d-block mb-2 text-muted opacity-50"></i>
                            <span>لم يتم العثور على أي عملاء مطابقين للبحث.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Customer Modal -->
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title fw-bold"><i class="bi bi-person-plus ms-1"></i> إضافة عميل جديد</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">اسم العميل بالكامل <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="مثال: أحمد محمد علي" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">رقم الهاتف</label>
                        <input type="text" name="PhoneNumber" class="form-control font-monospace" placeholder="010xxxxxxxx (أو اتركه فارغاً)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">رقم الواتساب</label>
                        <input type="text" name="WhatsAppNumber" class="form-control font-monospace" placeholder="اتركه فارغاً إذا كان مطابقاً للهاتف" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">نوع العميل وملاحظات الحساب</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="مثال: عميل دائم بالجملة والآجل، محل الأمل..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary btn-sm">حفظ العميل</button>
                </div>
            </form>
        </div>
    </div>
</div>
